# Copy this file to .env and fill in your own Supabase project credentials.
# Find these values in your Supabase project settings under "API".
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Web Push VAPID public key. Generate a pair with `npx web-push generate-vapid-keys`;
# the public key goes here, the private key is an Edge Function secret only
# (see README "Push notifications"). Never commit the private key.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# Optional: The Movie Database (TMDb) API key, for movie search/posters in
# the watchlist. Free account at themoviedb.org, no billing. Without it the
# watchlist still works, just without search/enrichment (title-only entries).
VITE_TMDB_API_KEY=your-tmdb-api-key
